<% layout('layouts/boilerplate') -%>

<div class="container py-4">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-white">Meet the Team</h2>
        <p class="text-secondary">The minds behind Code Sastra and the IT Department</p>
    </div>

    <!-- Department Leadership -->
    <h4 class="text-white border-bottom border-secondary border-opacity-25 pb-2 mb-4 text-center">Department Leadership</h4>
    <div class="row justify-content-center text-center g-4 mb-5">
        <div class="col-md-4">
            <img src="https://via.placeholder.com/150" class="rounded-circle border border-danger border-3 mb-3 shadow-sm" alt="HOD">
            <h5 class="text-white fw-bold mb-1">Name Here</h5>
            <p class="text-danger small text-uppercase tracking-wide">Head of Department (IT)</p>
        </div>
        <div class="col-md-4">
            <img src="https://via.placeholder.com/150" class="rounded-circle border border-danger border-3 mb-3 shadow-sm" alt="Dean">
            <h5 class="text-white fw-bold mb-1">Name Here</h5>
            <p class="text-danger small text-uppercase tracking-wide">Dean Academics</p>
        </div>
    </div>

    <!-- Core Club Coordinators -->
    <h4 class="text-white border-bottom border-secondary border-opacity-25 pb-2 mb-4 text-center">Core Coordinators</h4>
    <div class="row justify-content-center text-center g-4 mb-5">
        <div class="col-6 col-md-3">
            <img src="https://via.placeholder.com/120" class="rounded-circle mb-3 bg-black border border-secondary p-1" alt="Coordinator">
            <h6 class="text-white mb-0">Name Here</h6>
            <small class="text-secondary">Faculty Coordinator</small>
        </div>
        <div class="col-6 col-md-3">
            <img src="https://via.placeholder.com/120" class="rounded-circle mb-3 bg-black border border-secondary p-1" alt="President">
            <h6 class="text-white mb-0">Name Here</h6>
            <small class="text-secondary">President</small>
        </div>
        <div class="col-6 col-md-3">
            <img src="https://via.placeholder.com/120" class="rounded-circle mb-3 bg-black border border-secondary p-1" alt="Event Coord">
            <h6 class="text-white mb-0">Name Here</h6>
            <small class="text-secondary">Event Coordinator</small>
        </div>
        <div class="col-6 col-md-3">
            <img src="https://via.placeholder.com/120" class="rounded-circle mb-3 bg-black border border-secondary p-1" alt="Tech Lead">
            <h6 class="text-white mb-0">Name Here</h6>
            <small class="text-secondary">Technical Lead</small>
        </div>
        <div class="col-6 col-md-3">
            <img src="https://via.placeholder.com/120" class="rounded-circle mb-3 bg-black border border-secondary p-1" alt="Social Media">
            <h6 class="text-white mb-0">Name Here</h6>
            <small class="text-secondary">Social Media Team</small>
        </div>
    </div>

    <!-- Volunteers -->
    <h4 class="text-white border-bottom border-secondary border-opacity-25 pb-2 mb-4 text-center">Volunteers</h4>
    <div class="row text-center g-3 justify-content-center">
        <div class="col-4 col-md-2"><p class="text-secondary mb-0 bg-black py-2 rounded border border-secondary border-opacity-25">Volunteer 1</p></div>
        <div class="col-4 col-md-2"><p class="text-secondary mb-0 bg-black py-2 rounded border border-secondary border-opacity-25">Volunteer 2</p></div>
        <div class="col-4 col-md-2"><p class="text-secondary mb-0 bg-black py-2 rounded border border-secondary border-opacity-25">Volunteer 3</p></div>
        <div class="col-4 col-md-2"><p class="text-secondary mb-0 bg-black py-2 rounded border border-secondary border-opacity-25">Volunteer 4</p></div>
    </div>
</div>